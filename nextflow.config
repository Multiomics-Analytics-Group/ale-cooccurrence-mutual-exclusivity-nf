// Every task takes the path, size and date of this file as an input, so after a change to it
// -resume runs every task again.

manifest {
    nextflowVersion = '!>=26.04.0'
}

process {
    container = 'ale-cooccurrence:dev'
    // pipefail: a step whose output goes through tee still fails its task when it fails.
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Memory for each task, at least one and a half times its peak on the E. coli data. Docker
    // stops a task that goes over it, so larger data may need more.
    withName: 'QC_01_LOAD' {
        memory = 8.GB
    }
    withName: 'QC_02_SPECIES' {
        memory = 6.GB
    }
    withName: 'QC_03_STARTING_STRAIN' {
        memory = 2.GB
    }
    withName: 'QC_04_HYPERMUTATORS' {
        memory = 2.GB
    }
    withName: 'QC_05_GENE_NAMES' {
        memory = 1.GB
    }
    withName: 'QC_06_EXCLUSIONS' {
        memory = 1.GB
    }
    withName: 'QC_99_REPORT' {
        memory = 6.GB
    }
    withName: 'ANALYSIS' {
        memory = 1.GB
    }
}

docker {
    enabled = true
    // Tasks run as the user who starts Nextflow, so the files they write belong to that user.
    runOptions = '-u $(id -u):$(id -g)'
}

env {
    // MKL (used by discover), OpenBLAS (used by numpy and scipy) and numexpr each run on one
    // thread, so the order of floating-point operations does not depend on the number of CPUs.
    // MKL runs on the GNU OpenMP runtime with SSE4.2 code. KMP_DUPLICATE_LIB_OK and
    // MKL_ENABLE_INSTRUCTIONS are the settings of analysis_pipeline/scripts/run_all.sh, which
    // keep MKL from crashing on macOS and on older Intel CPUs.
    OMP_NUM_THREADS = '1'
    MKL_THREADING_LAYER = 'GNU'
    MKL_ENABLE_INSTRUCTIONS = 'SSE4_2'
    KMP_DUPLICATE_LIB_OK = 'TRUE'
    // Python reads and writes text as UTF-8 whatever the system locale.
    PYTHONUTF8 = '1'
    // Python would otherwise write compiled __pycache__ files into the repository's code folders.
    PYTHONDONTWRITEBYTECODE = '1'
}
